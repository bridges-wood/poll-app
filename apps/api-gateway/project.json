{
  "name": "api-gateway",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/api-gateway/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/webpack:webpack",
      "outputs": [
        "{options.outputPath}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "target": "node",
        "compiler": "tsc",
        "outputPath": "dist/apps/api-gateway",
        "main": "apps/api-gateway/src/main.ts",
        "tsConfig": "apps/api-gateway/tsconfig.app.json",
        "assets": [
          "apps/api-gateway/src/assets"
        ],
        "webpackConfig": "apps/api-gateway/webpack.config.js"
      },
      "configurations": {
        "development": {},
        "production": {
          "generatePackageJson": true
        }
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "api-gateway:build",
        "port": 0
      },
      "configurations": {
        "development": {
          "buildTarget": "api-gateway:build:development",
          "watch": true
        },
        "production": {
          "buildTarget": "api-gateway:build:production"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "{projectRoot}/**/*.ts"
        ]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "apps/api-gateway/jest.config.ts",
        "passWithNoTests": true
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    },
    "build-generator": {
      "executor": "@nx/webpack:webpack",
      "outputs": [
        "{options.outputPath}"
      ],
      "inputs": [
        "{projectRoot}/src/**/*.ts"
      ],
      "options": {
        "target": "node",
        "compiler": "tsc",
        "outputPath": "dist/apps/api-gateway/scripts",
        "main": "{projectRoot}/src/scripts/generate-schema.ts",
        "outputFileName": "generate-schema.js",
        "tsConfig": "{projectRoot}/tsconfig.app.json",
        "assets": [
          "{projectRoot}/src/assets"
        ],
        "webpackConfig": "{projectRoot}/webpack.config.js"
      }
    },
    "generate": {
      "dependsOn": [
        "build-generator"
      ],
      "command": "node dist/apps/api-gateway/scripts/generate-schema.js"
    },
    "container": {
      "executor": "@nx-tools/nx-container:build",
      "dependsOn": [
        "build"
      ],
      "options": {
        "file": "{projectRoot}/Dockerfile",
        "engine": "docker",
        "metadata": {
          "images": [
            "bridgeswood/api-gateway"
          ],
          "load": true,
          "tags": [
            "type=schedule",
            "type=ref,event=branch",
            "type=ref,event=tag",
            "type=ref,event=pr",
            "type=sha,prefix=sha-"
          ]
        }
      },
      "configurations": {
        "ci": {
          "push": true
        }
      }
    },
    "ssl": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "mkdir -p {projectRoot}/src/assets/ssl",
          "openssl req -x509 -newkey rsa:2048 -nodes -subj '/CN={projectName}' -addext 'subjectAltName=DNS:localhost' -keyout {args.private-key-location} -out {args.certificate-location} -CA ~/certs/myCA.pem -CAkey ~/certs/myCA.key -passin pass:{args.ca-password} -days 365"
        ]
      },
      "defaultConfiguration": "development",
      "configurations": {
        "development": {
          "args": [
            "--private-key-location={projectRoot}/src/assets/ssl/key.pem",
            "--certificate-location={projectRoot}/src/assets/ssl/cert.pem",
            "--ca-password=$SSL_ROOT_PASSWORD"
          ]
        }
      }
    }
  }
}
