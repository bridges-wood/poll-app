{
  "name": "post-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/post-service/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/webpack:webpack",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "target": "node",
        "compiler": "tsc",
        "outputPath": "dist/apps/post-service",
        "main": "apps/post-service/src/main.ts",
        "tsConfig": "apps/post-service/tsconfig.app.json",
        "assets": ["apps/post-service/src/assets"],
        "webpackConfig": "apps/post-service/webpack.config.js",
        "generatePackageJson": true
      },
      "configurations": {
        "development": {},
        "production": {}
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "post-service:build"
      },
      "configurations": {
        "development": {
          "buildTarget": "post-service:build:development"
        },
        "production": {
          "buildTarget": "post-service:build:production"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/post-service/jest.config.ts"
      }
    },
    "build-generator": {
      "executor": "@nx/webpack:webpack",
      "outputs": ["{options.outputPath}"],
      "inputs": ["{projectRoot}/src/*.ts"],
      "options": {
        "target": "node",
        "compiler": "tsc",
        "outputPath": "dist/apps/post-service/scripts",
        "main": "{projectRoot}/src/scripts/generate-schema.ts",
        "outputFileName": "generate-schema.js",
        "tsConfig": "{projectRoot}/tsconfig.app.json",
        "assets": ["{projectRoot}/src/assets"],
        "isolatedConfig": true,
        "webpackConfig": "{projectRoot}/webpack.config.js"
      },
      "cache": true
    },
    "generate": {
      "dependsOn": ["build-generator"],
      "command": "node dist/apps/post-service/scripts/generate-schema.js"
    },
    "container": {
      "executor": "@nx-tools/nx-container:build",
      "dependsOn": ["build"],
      "options": {
        "engine": "docker",
        "metadata": {
          "images": ["bridgeswood/post-service"],
          "load": true,
          "tags": [
            "type=schedule",
            "type=ref,event=branch",
            "type=ref,event=tag",
            "type=ref,event=pr",
            "type=sha,prefix=sha-"
          ]
        }
      },
      "configurations": {
        "ci": {
          "push": true
        }
      }
    }
  }
}
