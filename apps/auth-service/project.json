{
  "name": "auth-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/auth-service/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/webpack:webpack",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "target": "node",
        "compiler": "tsc",
        "outputPath": "dist/apps/auth-service",
        "main": "apps/auth-service/src/main.ts",
        "tsConfig": "apps/auth-service/tsconfig.app.json",
        "assets": ["apps/auth-service/src/assets"],
        "webpackConfig": "apps/auth-service/webpack.config.js"
      },
      "configurations": {
        "development": {},
        "production": {
          "generatePackageJson": true
        }
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "apps/auth-service:build",
        "port": 0
      },
      "configurations": {
        "development": {
          "buildTarget": "auth-service:build:development"
        },
        "production": {
          "buildTarget": "auth-service:build:production"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["{projectRoot}/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/auth-service/jest.config.ts",
        "passWithNoTests": true
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    },
    "build-generator": {
      "executor": "@nx/webpack:webpack",
      "outputs": ["{options.outputPath}"],
      "inputs": ["{projectRoot}/src/**/*.ts"],
      "options": {
        "target": "node",
        "compiler": "tsc",
        "outputPath": "dist/apps/auth-service/scripts",
        "main": "{projectRoot}/src/scripts/generate-schema.ts",
        "outputFileName": "generate-schema.js",
        "tsConfig": "{projectRoot}/tsconfig.app.json",
        "assets": ["{projectRoot}/src/assets"],
        "webpackConfig": "{projectRoot}/webpack.config.js"
      },
      "cache": true
    },
    "generate": {
      "dependsOn": ["build-generator"],
      "command": "node dist/apps/auth-service/scripts/generate-schema.js"
    },
    "container": {
      "executor": "@nx-tools/nx-container:build",
      "dependsOn": ["build"],
      "options": {
        "engine": "docker",
        "file": "{projectRoot}/Dockerfile",
        "metadata": {
          "images": ["bridgeswood/auth-service"],
          "load": true,
          "tags": [
            "type=schedule",
            "type=ref,event=branch",
            "type=ref,event=tag",
            "type=ref,event=pr",
            "type=sha,prefix=sha-"
          ]
        }
      },
      "configurations": {
        "ci": {
          "push": true
        }
      }
    },
    "ssl": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "mkdir -p {projectRoot}/src/assets/ssl",
          "openssl req -x509 -newkey rsa:2048 -nodes -subj '/CN={projectName}' -addext 'subjectAltName=DNS:localhost' -keyout {args.private-key-location} -out {args.certificate-location} -CA ~/certs/myCA.pem -CAkey ~/certs/myCA.key -passin pass:{args.ca-password} -days 365"
        ]
      },
      "defaultConfiguration": "development",
      "configurations": {
        "development": {
          "args": [
            "--private-key-location={projectRoot}/src/assets/ssl/key.pem",
            "--certificate-location={projectRoot}/src/assets/ssl/cert.pem",
            "--ca-password=$SSL_ROOT_PASSWORD"
          ]
        }
      }
    }
  }
}
