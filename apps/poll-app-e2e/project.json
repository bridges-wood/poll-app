{
  "name": "poll-app-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/poll-app-e2e/src",
  "tags": [],
  "implicitDependencies": ["poll-app"],
  "targets": {
    "e2e": {
      "executor": "@nx/cypress:cypress",
      "options": {
        "cypressConfig": "apps/poll-app-e2e/cypress.config.ts",
        "testingType": "e2e",
        "devServerTarget": "poll-app:serve"
      },
      "configurations": {
        "production": {
          "devServerTarget": "poll-app:serve:production"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["{projectRoot}/**/*.{js,ts}"]
      }
    }
  }
}
