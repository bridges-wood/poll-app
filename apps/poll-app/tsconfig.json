{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "allowJs": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "types": ["jest", "node"],
    "lib": ["dom", "dom.iterable", "esnext"],
    "target": "ESNext",
    "paths": {
      "@org/common": ["libs/common/src/index.ts"],
      "@org/graphql": ["libs/graphql/src/index.ts"],
      "@org/typings": ["libs/typings/src/index.ts"],
      "@org/graphql/server": ["libs/graphql/src/server.ts"],
      "@org/registration": ["libs/registration/src/index.ts"],
      "@poll-app/components/*": ["apps/poll-app/src/components/*"],
      "@poll-app/hooks/*": ["apps/poll-app/src/hooks/*"],
      "@poll-app/types/*": ["apps/poll-app/src/types/*"],
      "@poll-app/utils/*": ["apps/poll-app/src/utils/*"],
      "@poll-app/lib/*": ["apps/poll-app/src/lib/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "**/*.jsx",
    "../../apps/poll-app/.next/types/**/*.ts",
    "../../dist/apps/poll-app/.next/types/**/*.ts",
    "next-env.d.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "jest.config.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts"
  ]
}
